# Everything specific to this home, in one place. On the Pi, copy this file to
# core/.env (git-ignored) and fill in the blanks. Nothing else in core/ holds an
# address, a place or a domain, so moving house means editing only this file.

# Every service is <name>.${DOMAIN}; ${DOMAIN} itself is the Glance dashboard.
DOMAIN=lab.alamst.me

# The Raspberry Pi. Blocky answers ${DOMAIN} and every name under it with this
# address, so the Pi's Traefik receives every request first.
PI_IP=192.168.1.14

# The cluster's floating address (CLUSTER_VIP in k8s/cluster.env). The Pi's
# Traefik forwards every name it does not serve itself to the cluster here.
CLUSTER_IP=192.168.1.10

# Where the Pi keeps data outside the repo: $DATA_DIR/traefik/letsencrypt
# (certificates) and $DATA_DIR/homeassistant (Home Assistant's database).
DATA_DIR=/data

TZ=America/Mexico_City

# Glance weather widget.
WEATHER_LOCATION=Mexico City, Mexico

# Let's Encrypt account e-mail for the Pi's wildcard certificate.
ACME_EMAIL=alamst@proton.me

# Cloudflare API token with Zone / DNS / Edit on the domain's zone
# (dash.cloudflare.com/profile/api-tokens). Secret: only in core/.env.
CF_DNS_API_TOKEN=
