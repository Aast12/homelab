# Everything specific to this home's cluster. Copy to k8s/cluster.env
# (git-ignored) on the machine you run k8s/lab.sh from, and fill it in.

# k3s release every node installs.
K3S_VERSION=v1.37.2+k3s1

# Address of the k3s server node; agents join it here. Keep it stable (a DHCP
# reservation or a static address on the machine).
K3S_SERVER=192.168.1.11

# Shared secret nodes use to join. New cluster: openssl rand -hex 32.
# Existing cluster: sudo cat /var/lib/rancher/k3s/server/token on the server.
K3S_TOKEN=

# The cluster's floating address, held by whichever node kube-vip elects. It
# must be unused: no machine, VM or hypervisor may have it, and it must be
# outside the router's DHCP pool, or kube-vip takes over that machine's
# traffic. core/.env's CLUSTER_IP is the same value.
CLUSTER_VIP=
