# Settings for Jellyseerr, the arr apps and the downloaders. Copy to
# secrets.env (git-ignored) and fill in. lab.sh applies the stack once every
# uncommented key has a value; the commented ones are optional.

# One login for every app: Sonarr, Radarr, Lidarr, Prowlarr, Bazarr,
# qBittorrent, nzbget, Jellyfin and Jellyseerr. To change it later, change it
# here and run `lab.sh apply arr`; changing it inside an app is undone by the
# next run.
ADMIN_USER=
ADMIN_PASSWORD=

# Fixed API keys, so the setup Job can connect the apps. Generate all five:
#   for k in SONARR RADARR LIDARR PROWLARR BAZARR; do echo "${k}_API_KEY=$(openssl rand -hex 16)"; done
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=

# Proton VPN in front of qBittorrent and nzbget: the PrivateKey line of a
# WireGuard config made with NAT-PMP (port forwarding) on. See the README.
WIREGUARD_PRIVATE_KEY=
# Optional: only use servers in these countries, e.g. Mexico,United States.
# SERVER_COUNTRIES=

# Optional: subtitle languages for Bazarr (ISO 639-1 codes); default en,es.
# SUBTITLE_LANGUAGES=en,es
# Optional: free subtitle accounts for Bazarr. Podnapisi needs none and is
# always on; each of these is used once filled in.
# OPENSUBTITLES_USER=        # opensubtitles.com
# OPENSUBTITLES_PASSWORD=
# SUBDL_API_KEY=             # subdl.com, under your account's API key
# ADDIC7ED_USER=             # addic7ed.com, good for TV
# ADDIC7ED_PASSWORD=

# Optional: a Usenet provider for nzbget (paid; none are free).
# USENET_HOST=
# USENET_PORT=563
# USENET_SSL=yes
# USENET_USER=
# USENET_PASSWORD=
# USENET_CONNECTIONS=8
