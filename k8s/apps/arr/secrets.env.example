# gluetun settings for the VPN in front of qBittorrent and nzbget. Copy to
# secrets.env (git-ignored) and fill in; the gluetun keys from the old
# media/.env go here. lab.sh applies the arr stack only once every
# uncommented key has a value. Key names: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
# From a Proton WireGuard config with NAT-PMP (port forwarding) enabled.
WIREGUARD_PRIVATE_KEY=
# Optional: limit to servers in these countries, e.g. Mexico,United States.
# SERVER_COUNTRIES=
# Proton only forwards a port on P2P servers.
VPN_PORT_FORWARDING=on
PORT_FORWARD_ONLY=on
